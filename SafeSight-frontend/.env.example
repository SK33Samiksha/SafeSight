# Copy to .env.local (optional — the defaults work when everything runs on one computer)

# Where the Express backend runs. The website forwards /api/* requests to it,
# so other devices on your Wi-Fi only need to open http://<this-computer-ip>:3000
BACKEND_URL=http://localhost:5000

# Leave empty to use the forwarding above (recommended).
# Only set this if the backend is on a different public address.
NEXT_PUBLIC_API_URL=
