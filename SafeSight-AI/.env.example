# Copy to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=safesight

# Face model and decision threshold (cosine DISTANCE: lower = more similar).
# 0.40 is DeepFace's calibrated value for Facenet on full-resolution, detected faces.
# The 0.56 in the project report was tuned on 50x37 greyscale LFW crops; see evaluation/lfw_eval.py.
FACE_MODEL=Facenet
FACE_DETECTOR=opencv
MATCH_THRESHOLD=0.40
TOP_K=3
